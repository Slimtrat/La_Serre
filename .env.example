COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_SECONDS=1800
COMFYUI_POLL_INTERVAL_SECONDS=1

# Copy the examples from workflows/*/*.profile.json.example, then set their
# workflow field to an API-format workflow exported by your local ComfyUI.
KEYFRAME_WORKFLOW_PROFILE=./workflows/local/keyframe.profile.json
VIDEO_WORKFLOW_PROFILE=./workflows/local/ltx-i2v.profile.json

OUTPUT_DIR=./output
DEFAULT_VIDEO_BACKEND=ltx

LLM_PROVIDER=ollama
